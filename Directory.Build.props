<Project>
  <!-- Wspólne ustawienia wszystkich projektów; importowane automatycznie przez MSBuild. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1900</WarningsNotAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Włącza analizę /// (CS1591) i reguły dokumentacyjne StyleCop (strict). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Bez nagłówków plików (brak takiej zasady w tym repo). -->
    <NoWarn>$(NoWarn);SA1633;SA1635</NoWarn>
  </PropertyGroup>
</Project>

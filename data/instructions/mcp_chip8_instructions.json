    "words": "integer; always 2 (16-bit)",
    "semantics": "description of behavior; prefix 'Verified:' after test pass (test-driven definition)",
    "group": "category (system, display, timing, logic, memory, etc)",
    "encoding": "instruction format pattern (X=register nibble, Y=register nibble, N=4-bit value, NN=byte, NNN=12-bit address)",

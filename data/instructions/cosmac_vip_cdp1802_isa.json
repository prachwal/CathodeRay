{
  "processor": "COSMAC VIP / RCA CDP1802",
  "format_version": "1.0",
  "description": "RCA COSMAC CDP1802 instruction set used by the COSMAC VIP. 16-bit register architecture with 16 general-purpose 16-bit registers R0-RF, D accumulator, DF data flag, P program-counter selector, X data-pointer selector, Q output flip-flop, IE interrupt enable and T temporary register.",
  "notes": "CDP1802 has a 16-bit address space (64 KiB), byte-addressable memory, 16 x 16-bit registers, 8-bit D register, 1-bit DF, 1-bit Q and 1-bit IE. Any R register can be selected as P (program counter) or X (data pointer). Most instructions require 2 machine cycles; long branch/long skip/NOP require 3. One machine cycle consists of 8 clock periods. COSMAC VIP adds system-specific hardware such as the CDP1861 video interface; this JSON describes the CPU ISA, not the VIP video hardware or CHIP-8 interpreter.",
  "schema": {
    "opcode": "hex string/pattern; 8-bit opcode with N/register, MM/page-byte or KK/immediate placeholders",
    "mnemonic": "RCA COSMAC symbolic instruction name",
    "cycles": "integer; machine cycles",
    "words": "integer; number of program bytes consumed (1, 2 or 3)",
    "semantics": "description of CPU behavior",
    "group": "category such as memory, register, branch, arithmetic, control, interrupt, io or skip",
    "encoding": "instruction format pattern",
    "operands": "array of operand objects or null; each: {type, name, range, position}",
    "variants": "optional; variant opcodes or parameters (null if none)"
  },
  "registers": {
    "R0-RF": "16 x 16-bit scratchpad registers",
    "D": "8-bit data register / accumulator",
    "DF": "1-bit data flag; carry/no-borrow indicator for arithmetic",
    "P": "4-bit selector identifying the program-counter register R(P)",
    "X": "4-bit selector identifying the data-pointer register R(X)",
    "N": "4-bit instruction register field selecting R(N)",
    "I": "4-bit high opcode nibble",
    "T": "8-bit temporary register used by interrupt/return mechanisms",
    "IE": "1-bit interrupt-enable flip-flop",
    "Q": "1-bit output flip-flop",
    "EF1-EF4": "four external input flag lines"
  },
  "interrupts_and_dma": {
    "interrupt": "On interrupt acceptance, T receives the current X/P state, X becomes 2, P becomes 1 and IE becomes 0.",
    "dma_in": "External DMA request transfers bus data to M(R0), then increments R0.",
    "dma_out": "External DMA request transfers M(R0) to the bus, then increments R0.",
    "reset": "Reset initializes the CPU control state according to the CDP1802 hardware specification."
  },
